---
// src/components/Hero.astro
// "ENTRADA ILCAPO" -- reemplaza "Declaración monumental" (pedido explícito del
// Ingeniero Líder: construyó un prototipo standalone en _pruebas/robles-scroll/
// replicando la estética de ilcapoproduction.com y pidió "quiero que este sea el home
// de grupo los robles"). Portado 1:1 desde ese prototipo (estructura/motion/timing
// probados ahí), con dos cambios deliberados respecto al original:
//   1. Paleta y tipografía SIEMPRE vía las variables reales del tema (--bg-primary,
//      --accent, --accent-hover, --text-primary/--text-secondary, --font-heading) en
//      vez de la paleta duplicada (--bg/--green/--paper...) que el prototipo
//      redefinía a mano -- misma regla de siempre: una sola fuente de verdad de color.
//   2. Tipografía: var(--font-heading) (Geist) para el wordmark, NO la serif Didone/
//      Bodoni Moda del prototipo -- el sistema tipográfico de 4 roles (Geist/Space
//      Grotesk/Geist Mono/Inter) está fijado como regla dura del proyecto desde antes;
//      introducir una quinta familia serif sería un giro de identidad que nadie pidió
//      explícitamente. Mismo criterio: peso tope 600 (el prototipo usaba 700 en el
//      wordmark, prohibido -- corregido acá).
//
// El header/menú propios del prototipo (`.bar`/`.menu`) y su footer (`.end`) NO se
// portan: ya existen Header.astro/SideNav.astro/Footer.astro reales en Layout.astro,
// con el loading (Preloader.astro) que el Ingeniero pidió explícitamente mantener --
// duplicarlos habría repetido navegación/footer dos veces en la misma página (mismo
// tipo de bug ya corregido antes en "Nuestras Divisiones").
//
// Reel: los 5 videos reales de cada división (ya existentes en /videos, incluye los
// clips reales de marca BOSS/HUGO/GEOX y Mil Sabores generados este mismo turno) se
// superponen como "carrete" -- uno visible a la vez, sincronizado al scroll -- en vez
// del shader abstracto anterior (que a su vez había reemplazado el video sesgado a una
// sola división). Esta es la solución real al pedido original ("no refleja las 5
// industrias"): las 5 aparecen, una por una, en proporción igual.
const { divisions = [], locale = 'es' } = Astro.props;

const siteName = 'Grupo Los Robles';
const srHeadline = locale === 'en'
  ? `${siteName}. Five industries, one standard.`
  : `${siteName}. Cinco industrias, un mismo estándar.`;
const hintLabel = locale === 'en' ? 'Scroll' : 'Scroll';
const reelLabels = divisions.map((d) => d.reelLabel ?? d.name);
---

<section id="inicio" class="hero" data-gsap-section="hero" aria-label={siteName}>
  <div class="hero__stick" data-hero-stick>
    <div class="hero__reel" data-hero-reel aria-hidden="true">
      {divisions.map((d, i) => (
        <video
          class="hero__reel-video"
          data-hero-reel-video
          data-src={`/videos/${d.id}.mp4`}
          poster={d.image}
          muted
          loop
          playsinline
          preload={i === 0 ? 'auto' : 'none'}
        />
      ))}
    </div>

    <h1 class="hero__word" data-hero-word aria-hidden="true"><span>Grupo</span><span>Los Robles</span></h1>
    <p class="hero__sr-heading">{srHeadline}</p>

    <div class="hero__curtain" data-hero-curtain aria-hidden="true">
      <p class="hero__curtain-label" data-hero-curtain-label>{reelLabels[0]}</p>
    </div>

    <div class="hero__scrollhint" data-hero-hint aria-hidden="true">{hintLabel}</div>
  </div>
</section>

<script define:vars={{ reelLabels }}>
  function clamp(v, a, b) { return Math.max(a, Math.min(b, v)); }
  function lerp(a, b, t) { return a + (b - a) * t; }
  function ease(t) { return 1 - Math.pow(1 - t, 3); }
  function vh() { return window.innerHeight; }

  let sectionEl, stickEl, reelEl, reelVids, wordEl, curtainEl, curtainLabelEl, hintEl;
  let activeReel = -1;
  let reduced = false;
  let rafScheduled = false;

  function fitWord() {
    if (!wordEl) return;
    const lines = wordEl.querySelectorAll('span');
    const pad = window.innerWidth * 0.03;
    const w = wordEl.clientWidth - pad * 2;
    wordEl.style.fontSize = '100px';
    let max = 0;
    lines.forEach((s) => {
      s.style.display = 'inline-block';
      max = Math.max(max, s.getBoundingClientRect().width);
      s.style.display = 'block';
    });
    if (max > 0) wordEl.style.fontSize = `${(100 * w) / max}px`;
  }

  function setReel(i) {
    if (i === activeReel || !reelVids.length) return;
    activeReel = i;
    reelVids.forEach((v, k) => {
      if (k === i) {
        if (!v.src && v.dataset.src) v.src = v.dataset.src;
        v.classList.add('is-on');
        const p = v.play();
        if (p && p.catch) p.catch(() => {});
      } else {
        v.classList.remove('is-on');
      }
    });
    const next = reelVids[i + 1];
    if (next && !next.src && next.dataset.src) next.src = next.dataset.src;
    if (curtainLabelEl) curtainLabelEl.textContent = reelLabels[i] ?? '';
  }

  function heroFrame() {
    rafScheduled = false;
    if (!sectionEl) return;
    const r = sectionEl.getBoundingClientRect();
    const total = sectionEl.offsetHeight - vh();
    if (total <= 0) return;
    const p = clamp(-r.top / total, 0, 1);

    // Fase 1 (0-.18): franja angosta -> pantalla completa.
    const a = ease(clamp(p / 0.18, 0, 1));
    const top = lerp(33, 0, a);
    const bot = lerp(37, 0, a);
    const side = lerp(4, 0, a);
    reelEl.style.top = `${top}%`;
    reelEl.style.bottom = `${bot}%`;
    reelEl.style.left = `${side}%`;
    reelEl.style.right = `${side}%`;

    const wh = wordEl.getBoundingClientRect().height || 200;
    const y0 = vh() * 0.67;
    const y1 = vh() * 0.46 - wh / 2;
    wordEl.style.top = `${lerp(y0, Math.max(y1, vh() * 0.18), a)}px`;
    if (hintEl) hintEl.style.opacity = String(1 - clamp(p / 0.08, 0, 1));

    // Fase 2 (.1-.88): avanza el carrete de 5 videos.
    const rp = clamp((p - 0.1) / 0.78, 0, 0.9999);
    setReel(Math.floor(rp * reelVids.length));

    // Fase 3 (.8-1): cortina sube y recorta el wordmark.
    const c = ease(clamp((p - 0.8) / 0.2, 0, 1));
    curtainEl.style.transform = `translateY(${lerp(100, 24, c)}%)`;
    wordEl.style.transform = `translateY(${-c * vh() * 0.12}px)`;
  }

  function onScroll() {
    if (!rafScheduled) {
      rafScheduled = true;
      requestAnimationFrame(heroFrame);
    }
  }
  function onResize() {
    fitWord();
    heroFrame();
  }

  function initStatic() {
    // Fallback obligatorio sin animación (prefers-reduced-motion): el carrete muestra
    // la primera división a pantalla completa, sin franja/cortina/scrub.
    reelEl.style.top = '0%';
    reelEl.style.bottom = '0%';
    reelEl.style.left = '0%';
    reelEl.style.right = '0%';
    wordEl.style.top = `${vh() * 0.46 - (wordEl.getBoundingClientRect().height || 200) / 2}px`;
    curtainEl.style.transform = 'translateY(100%)';
    if (hintEl) hintEl.style.opacity = '0';
    setReel(0);
  }

  function initHero() {
    sectionEl = document.querySelector('[data-gsap-section="hero"]');
    stickEl = document.querySelector('[data-hero-stick]');
    reelEl = document.querySelector('[data-hero-reel]');
    wordEl = document.querySelector('[data-hero-word]');
    curtainEl = document.querySelector('[data-hero-curtain]');
    curtainLabelEl = document.querySelector('[data-hero-curtain-label]');
    hintEl = document.querySelector('[data-hero-hint]');
    if (!sectionEl || !reelEl || !wordEl || !curtainEl) return;
    reelVids = [].slice.call(reelEl.querySelectorAll('[data-hero-reel-video]'));
    reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    fitWord();

    if (reduced) {
      initStatic();
      window.addEventListener('resize', fitWord);
      return;
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onResize);
    (document.fonts && document.fonts.ready ? document.fonts.ready : Promise.resolve()).then(() => {
      fitWord();
      heroFrame();
    });
    heroFrame();
    setReel(0);
  }

  function cleanupHero() {
    window.removeEventListener('scroll', onScroll);
    window.removeEventListener('resize', onResize);
    window.removeEventListener('resize', fitWord);
    reelVids?.forEach((v) => v.pause());
    activeReel = -1;
  }

  document.addEventListener('astro:page-load', initHero);
  document.addEventListener('astro:before-swap', cleanupHero);
</script>

<style>
  .hero {
    position: relative;
    height: 420vh;
  }

  .hero__stick {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    background-color: var(--accent);
    color-scheme: dark;
  }

  .hero__reel {
    position: absolute;
    overflow: hidden;
    background-color: var(--bg-primary);
    top: 33%;
    bottom: 37%;
    left: 4%;
    right: 4%;
  }
  .hero__reel-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .hero__reel-video.is-on { opacity: 1; }

  .hero__word {
    position: absolute;
    left: 0;
    right: 0;
    top: 67%;
    text-align: center;
    font-family: var(--font-heading);
    font-weight: 600;
    text-transform: uppercase;
    line-height: 0.8;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    white-space: nowrap;
    z-index: 2;
    will-change: transform, top;
  }
  .hero__word span { display: block; }

  .hero__sr-heading {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hero__curtain {
    position: absolute;
    inset: 0;
    background-color: var(--bg-primary);
    transform: translateY(100%);
    z-index: 3;
    display: flex;
    justify-content: center;
    padding-top: var(--space-md);
    will-change: transform;
  }
  .hero__curtain-label {
    font-family: var(--font-mono);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-hover);
  }

  .hero__scrollhint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--space-md);
    text-align: center;
    z-index: 4;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-primary);
    transition: opacity 0.4s ease;
  }

  @media (max-width: 700px) {
    .hero__scrollhint { bottom: var(--space-sm); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__reel-video, .hero__scrollhint { transition: none; }
  }
</style>
