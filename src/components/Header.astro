---
// src/components/Header.astro
// Chrome global del sitio. "ART DIRECTION RESET" (pedido explicito del Ingeniero):
// "no utilizar una barra blanca superior, el header debe integrarse con el fondo
// oscuro" -- se elimina por completo el sistema anterior de pill clara/inversion a
// oscuro sobre secciones claras (ya era logica muerta: ninguna seccion real del sitio
// declara data-header-theme="light" desde el pivote a oscuro-por-defecto). El header
// ahora es siempre una pill oscura y translucida. Nav discreta a la derecha
// (Industrias / Nuestro alcance / Contacto) + CTA "Hablemos", visible desde desktop;
// en mobile esos enlaces se recogen en el menu lateral (SideNav.astro) via el toggle.
// Lee contracts/site*.json (fuente única de marca) según `locale`.
import siteEs from '../../contracts/site.json';
import siteEn from '../../contracts/site.en.json';

const { locale = 'es' } = Astro.props;
const site = locale === 'en' ? siteEn : siteEs;
const { siteName } = site.site;

// Root-relative (import.meta.env.BASE_URL), no relativo a la carpeta actual: con una
// sola pagina (index.astro en "/") "en/" y "#inicio" resolvian bien por accidente, pero
// ahora el Header vive en varias rutas reales (/gastronomia, /vestuario, etc.) -- un
// link relativo tipo "en/" desde "/gastronomia/" apuntaria a "/gastronomia/en/", no a
// "/en/". Root-relative funciona igual sin importar desde que pagina se abra el Header.
const base = import.meta.env.BASE_URL;
const altHref = locale === 'en' ? base : `${base}en/`;
const homeHref = locale === 'en' ? `${base}en/` : base;
const altLabel = locale === 'en' ? 'ES' : 'EN';
const openLabel = locale === 'en' ? 'Open menu' : 'Abrir menú';

// Anclas reales del Home (root-relative, mismo criterio que homeHref/altHref arriba --
// funcionan igual desde cualquier pagina del sitio, no solo desde "/").
const homePrefix = locale === 'en' ? `${base}en/` : base;
const t = locale === 'en'
  ? { industries: 'Industries', contact: 'Contact', cta: "Let's talk" }
  : { industries: 'Industrias', contact: 'Contacto', cta: 'Hablemos' };
// "Nuestro alcance" se quitó junto con la sección Legacy (pedido explícito del
// Ingeniero Líder: "eliminar toda la sección" -- nunca dejar un link roto a un ancla
// que ya no existe).
const navLinks = [
  { label: t.industries, href: `${homePrefix}#divisiones` },
  { label: t.contact, href: `${homePrefix}#contacto` },
];
const ctaHref = `${homePrefix}#contacto`;
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href={homeHref} class="logo" aria-label={`${siteName}, ${locale === 'en' ? 'Home' : 'Inicio'}`}>
      <img class="logo__img" src="images/LOGO-LOSrOBLES-BLANCO.webp" alt={siteName} />
    </a>

    <nav class="site-header__nav" aria-label={locale === 'en' ? 'Primary' : 'Principal'}>
      <ul role="list">
        {navLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a href={altHref} class="lang-switch" aria-label={`${locale === 'en' ? 'Switch to Spanish' : 'Cambiar a inglés'}`}>{altLabel}</a>

      <a href={ctaHref} class="site-header__cta">{t.cta}</a>

      <button
        class="nav-toggle"
        aria-label={openLabel}
        aria-expanded="false"
        aria-controls="sidenav"
        data-nav-toggle
      >
        <span class="nav-toggle__bars"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<script>
  // Envuelto en astro:page-load (en vez de correr una sola vez a nivel de módulo): con
  // ClientRouter, este script no se re-ejecuta tras una transición (mismo contenido ya
  // corrido), así que sin esto los listeners quedaban atados al <header> de la página
  // anterior (nodo ya desmontado) y el header nuevo nunca recibía `.is-scrolled` — se
  // quedaba invisible tras cambiar de idioma.
  let cleanupHeader: (() => void) | undefined;

  function initHeader() {
    const header = document.querySelector<HTMLElement>('[data-header]');
    const toggle = document.querySelector<HTMLElement>('[data-nav-toggle]');
    const cleanups: Array<() => void> = [];

    // Header se vuelve sólido al hacer scroll
    if (header) {
      const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 40);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      cleanups.push(() => window.removeEventListener('scroll', onScroll));
    }

    // El estado (abierto/cerrado) lo dueño lo tiene SideNav.astro; Header solo despacha el toggle
    if (toggle) {
      const onToggleClick = () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        toggle.classList.toggle('is-active', !open);
        document.dispatchEvent(new CustomEvent('sidenav:toggle'));
      };
      const onSidenavClosed = () => {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.classList.remove('is-active');
      };

      toggle.addEventListener('click', onToggleClick);
      document.addEventListener('sidenav:closed', onSidenavClosed);
      cleanups.push(() => {
        toggle.removeEventListener('click', onToggleClick);
        document.removeEventListener('sidenav:closed', onSidenavClosed);
      });
    }

    cleanupHeader = () => cleanups.forEach((fn) => fn());
  }

  document.addEventListener('astro:page-load', initHeader);
  document.addEventListener('astro:before-swap', () => cleanupHeader?.());
</script>

<style>
  /* Fixed (no sticky): no reserva espacio en el flujo — el Hero arranca en el y:0 real
     de la página, "lo más arriba posible" (pedido del Ingeniero). Oculto por defecto:
     recién se revela al primer scroll (mismo umbral que ya dispara .is-scrolled). */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: var(--z-modal);
    background-color: transparent;
    border-bottom: 1px solid transparent;
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    transition: opacity var(--transition-smooth), transform var(--transition-smooth), background-color var(--transition-fast), border-color var(--transition-fast), backdrop-filter var(--transition-fast);
  }

  .site-header.is-scrolled {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
    /* Pill SIEMPRE oscura (pedido explicito del "ART DIRECTION RESET": "no utilizar una
       barra blanca superior, el header debe integrarse con el fondo oscuro") -- ya no
       existe inversion a pill clara, el sitio es oscuro por defecto de punta a punta. */
    background-color: color-mix(in srgb, var(--bg-primary) 80%, transparent);
    backdrop-filter: blur(14px);
    border-bottom-color: color-mix(in srgb, var(--border) 60%, transparent);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: var(--space-sm);
  }

  /* ── Logo ── */
  .logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  .logo__img {
    height: clamp(1.75rem, 3vw, 2.25rem);
    width: auto;
  }

  /* ── Nav discreta (Industrias / Nuestro alcance / Contacto) -- solo desktop, pedido
     explicito del brief; en mobile se recoge en SideNav.astro vía el toggle. ── */
  .site-header__nav { display: none; }
  .site-header__nav ul {
    list-style: none;
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }
  .site-header__nav a {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .site-header__nav a:hover { color: var(--text-primary); }

  @media (min-width: 1024px) {
    .site-header__nav { display: block; }
  }

  /* ── Acciones (idioma + CTA + toggle) ── */
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .lang-switch {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    color: var(--text-primary);
    text-decoration: none;
    opacity: 0.75;
    transition: opacity var(--transition-fast), color var(--transition-fast);
  }
  .lang-switch:hover { opacity: 1; }

  /* CTA "Hablemos" -- tipografico puro, mismo lenguaje que Hero/Contact (pedido
     explicito: nunca un segundo color de acento, el verde institucional es el unico). */
  .site-header__cta {
    display: none;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-hover);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid color-mix(in srgb, var(--accent-hover) 50%, transparent);
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }
  .site-header__cta:hover {
    color: var(--accent-hover);
    border-color: var(--accent-hover);
  }

  @media (min-width: 1024px) {
    .site-header__cta { display: inline-block; }
  }

  /* ── Toggle del menú lateral ── */
  /* Sin borde ni fondo: solo el ícono, elegante y suelto (pedido del Ingeniero) */
  .nav-toggle {
    display: flex;
    align-items: center;
    background: none;
    border: none;
    padding: var(--space-xs);
    cursor: pointer;
    transition: opacity var(--transition-fast);
  }
  .nav-toggle:hover {
    opacity: 0.7;
  }

  .nav-toggle__bars {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 7px;
    width: 28px;
  }
  .nav-toggle__bars span {
    display: block;
    height: 1px;
    width: 100%;
    background-color: var(--text-primary);
    transition: transform var(--transition-fast), opacity var(--transition-fast), background-color var(--transition-fast);
    transform-origin: center;
  }
  .nav-toggle.is-active .nav-toggle__bars span:nth-child(1) { transform: translateY(8px) rotate(45deg); }
  .nav-toggle.is-active .nav-toggle__bars span:nth-child(2) { opacity: 0; }
  .nav-toggle.is-active .nav-toggle__bars span:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }
</style>
