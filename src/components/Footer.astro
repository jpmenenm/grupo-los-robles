---
// src/components/Footer.astro
// Footer único del sitio (pedido explícito: "quiero que la pagina de contacto tenga
// el mismo footer que el home... manten esa buena practica de aqui en adelante" --
// UN solo diseño de footer para TODO el sitio, nunca dos distintos). Mismo diseño
// "ENTRADA ILCAPO" que vive en HomeReplica.astro (Contacto/Síguenos/Oficina + wordmark
// gigante de una sola línea + fila de copyright/tagline), extraído a este componente
// compartido para que Layout.astro (cualquier página con chrome=true, ej. /contacto/)
// y HomeReplica.astro (Home, chrome=false, lo importa directo) rendericen EXACTAMENTE
// lo mismo. Cualquier página nueva que use Layout.astro lo hereda automáticamente.
import siteEs from '../../contracts/site.json';
import siteEn from '../../contracts/site.en.json';

const { locale = 'es' } = Astro.props;
const site = locale === 'en' ? siteEn : siteEs;

const t = locale === 'en'
  ? { contacto: 'Contact', hablemos: "Let's talk →", siguenos: 'Follow us', oficina: 'Office', rights: 'All rights reserved.' }
  : { contacto: 'Contacto', hablemos: 'Hablemos →', siguenos: 'Síguenos', oficina: 'Oficina', rights: 'Todos los derechos reservados.' };

const year = new Date().getFullYear();
const { siteName, tagline } = site.site;
const company = site.company ?? {};
const social = site.social ?? [];
const orderUrl = site.orderUrl ?? '#';
---

<footer class="end" id="cierre">
  <div class="end-top">
    <div><h3>{t.contacto}</h3><a href={orderUrl}>{t.hablemos}</a></div>
    {social.length > 0 && (
      <div>
        <h3>{t.siguenos}</h3>
        {social.map((s) => (
          <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>
        ))}
      </div>
    )}
    {company.address && <div><h3>{t.oficina}</h3><p>{company.address}</p></div>}
  </div>

  <p class="end-word" data-footer-giant style="position:relative"><span>{siteName}</span></p>

  <div class="end-bot">
    <span>&copy; {year} {company.legalName ?? siteName}. {t.rights}</span>
    {tagline && <span>{tagline}</span>}
  </div>
</footer>

<script>
  // Wordmark de UNA línea, de borde a borde: un font-size en vw puro es solo una
  // aproximación -- el ancho real renderizado (fuente/kerning/peso) nunca calza exacto
  // con ningún vw fijo. Fix: medir el ancho real del <span> interno y escalar el
  // font-size en px para llenar el contenedor exacto, sin cortes ni partirse en 2
  // líneas (mismo mecanismo que HomeReplica.astro usa para sus propios wordmarks).
  function fitGiant() {
    const el = document.querySelector('[data-footer-giant]');
    const span = el?.querySelector('span');
    if (!el || !span) return;
    // el.clientWidth (NO parentElement): el <p> vive directo dentro de .end, que tiene
    // su propio padding horizontal (96px 24px 24px) -- el clientWidth del PADRE incluye
    // ese padding de más, dando un ancho objetivo más grande del que el <p> realmente
    // tiene disponible (bug real: el wordmark quedaba cortado en el borde derecho).
    // clientWidth del propio <p> (width:100% del padre) ya excluye ese padding bien.
    const w = el.clientWidth;
    if (!w) return;
    el.style.fontSize = '100px';
    // offsetWidth, no getBoundingClientRect(): si este <p> alguna vez quedara dentro
    // de un ancestro con transform activo, offsetWidth sigue siendo la caja de layout
    // real, nunca afectada por ese transform (mismo criterio que fit() en HomeReplica).
    span.style.display = 'inline-block';
    const textWidth = span.offsetWidth;
    span.style.display = '';
    if (textWidth > 0) el.style.fontSize = `${(100 * w) / textWidth}px`;
  }

  function onResize() { fitGiant(); }

  function initFooterGiant() {
    fitGiant();
    (document.fonts && document.fonts.ready ? document.fonts.ready : Promise.resolve()).then(fitGiant);
    window.addEventListener('resize', onResize);
  }

  document.addEventListener('astro:page-load', initFooterGiant);
  document.addEventListener('astro:before-swap', () => {
    window.removeEventListener('resize', onResize);
  });
</script>

<style>
  /* Variables locales (mismo criterio que HomeReplica.astro/.ilcapo): SIEMPRE las
     variables reales del tema, nunca hex nuevos -- esto solo les da un alias corto. */
  .end {
    --paper: var(--text-primary);
    --green-lt: var(--accent-hover);
    --f-grotesk: 'Helvetica Neue', 'HelveticaNeue', Helvetica, Arial, sans-serif;
    --f-didone: 'Ivar Display', 'Ivar Display Condensed', 'Bodoni Moda', 'Didot', serif;

    position: relative;
    min-height: 100vh;
    background: var(--accent);
    color: var(--paper);
    font-family: var(--f-grotesk);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 96px 24px 24px;
    overflow: hidden;
    color-scheme: dark;
  }

  .end-top { display: flex; justify-content: space-around; gap: 24px; flex-wrap: wrap; text-align: center; }
  .end-top h3 { font-family: var(--f-didone); font-weight: 400; text-transform: uppercase; font-size: clamp(26px, 3vw, 40px); margin-bottom: 8px; }
  .end-top a, .end-top p { font-size: 14px; text-transform: uppercase; letter-spacing: 0.02em; display: block; color: inherit; text-decoration: none; }
  .end-top a:hover { border-bottom: 1px solid var(--paper); }

  /* Wordmark gigante: mismo .word de HomeReplica.astro (Helvetica Neue, peso 500, sin
     máscara de imagen) -- "textura de marca", nunca un letrero de neón. */
  .end-word {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    margin: 0;
    overflow: hidden;
    text-align: center;
    font-family: var(--f-grotesk);
    font-weight: 500;
    text-transform: uppercase;
    line-height: 0.8;
    letter-spacing: -0.045em;
    color: var(--paper);
    white-space: nowrap;
    font-size: 11vw;
  }

  .end-bot { display: flex; justify-content: space-between; align-items: flex-end; font-size: 13px; text-transform: uppercase; margin-top: 24px; flex-wrap: wrap; gap: 8px; }

  @media (max-width: 700px) {
    .end { padding: 88px 16px 16px; }
  }
</style>
