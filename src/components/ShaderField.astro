---
// src/components/ShaderField.astro
// Fondo de hero genérico pero elegante (pedido explícito: "la imagen de inicio no
// refleja las 5 industrias... mejor una imagen en movimiento genérica pero elegante, o
// una gradiente que se mueve"). Reemplaza el video de fondo de Hero.astro (que mostraba
// la foto de UNA sola división, sesgada). Shader WebGL vía OGL (CLAUDE.md §17): un mesh
// gradient de 3 "blobs" de color que respiran/flotan lento -- nunca una foto de stock
// genérica, nunca un color inventado (los 3 tonos son var(--bg-primary)/var(--accent)/
// var(--accent-hover) leídos en runtime, nunca hardcodeados en el GLSL).
//
// Reglas aplicadas (§17.3): fallback CSS estático SIEMPRE presente debajo del canvas;
// sin animar si prefers-reduced-motion (canvas ni se inicializa); IntersectionObserver
// pausa el rAF fuera de viewport; dpr <= 2; pausa en visibilitychange; destruye el
// contexto WebGL en astro:before-swap; init en astro:page-load (no un evento one-shot).
---

<div class="shader-field" aria-hidden="true">
  <canvas class="shader-field__canvas" data-shader-canvas></canvas>
</div>

<script>
  import { Renderer, Program, Mesh, Triangle } from 'ogl';

  const VERT = `
    attribute vec2 uv;
    attribute vec2 position;
    varying vec2 vUv;
    void main() {
      vUv = uv;
      gl_Position = vec4(position, 0.0, 1.0);
    }
  `;

  const FRAG = `
    precision highp float;
    uniform float uTime;
    uniform vec2 uResolution;
    uniform vec3 uColorBg;
    uniform vec3 uColorAccent;
    uniform vec3 uColorAccentLight;
    varying vec2 vUv;

    float blob(vec2 uv, vec2 center, float radius) {
      float d = distance(uv, center);
      // smoothstep(edge0, edge1, x) es comportamiento INDEFINIDO si edge0 >= edge1 (spec
      // GLSL) -- bug real detectado ("se mueve extraño"): con radius > radius*0.1 el
      // orden estaba invertido, y cada GPU/driver lo resuelve distinto (bordes duros,
      // parpadeo). Forma correcta: 1 en el centro, 0 en el borde, con edge0=0 < edge1=radius.
      return 1.0 - smoothstep(0.0, radius, d);
    }

    void main() {
      float aspect = uResolution.x / uResolution.y;
      vec2 uv = vUv;
      uv.x *= aspect;

      // uTime ya llega en segundos desde el primer frame de ESTA instancia (ver script
      // más abajo) -- nunca el timestamp crudo de rAF (milisegundos, crece sin límite):
      // sin/cos en GPU pierden precisión con ángulos grandes y el movimiento se ve
      // tembloroso/errático después de un rato con la pestaña abierta (segundo bug real
      // detrás de "se mueve extraño").
      float t = uTime * 0.045;

      vec2 c1 = vec2(0.32 + sin(t * 0.8) * 0.16, 0.62 + cos(t * 0.6) * 0.14);
      vec2 c2 = vec2(0.72 + cos(t * 0.5) * 0.18, 0.34 + sin(t * 0.7) * 0.16);
      vec2 c3 = vec2(0.5 + sin(t * 0.35 + 2.1) * 0.22, 0.52 + cos(t * 0.4 + 1.3) * 0.2);
      c1.x *= aspect;
      c2.x *= aspect;
      c3.x *= aspect;

      float b1 = blob(uv, c1, 0.6);
      float b2 = blob(uv, c2, 0.55);
      float b3 = blob(uv, c3, 0.65);

      vec3 color = uColorBg;
      color = mix(color, uColorAccent, b1 * 0.75);
      color = mix(color, uColorAccentLight, b2 * 0.3);
      color = mix(color, uColorAccent, b3 * 0.45);

      gl_FragColor = vec4(color, 1.0);
    }
  `;

  function hexToRgb01(hex: string): [number, number, number] {
    const m = hex.trim().replace('#', '');
    const full = m.length === 3 ? m.split('').map((c) => c + c).join('') : m;
    const num = parseInt(full, 16);
    return [((num >> 16) & 255) / 255, ((num >> 8) & 255) / 255, (num & 255) / 255];
  }

  // Los colores pueden venir como hex (`--accent`) o como color-mix()/otra función CSS
  // (`--accent-hover`) -- para leer el valor REAL ya resuelto por el navegador (nunca
  // re-derivar un color a mano), se pinta en un <div> invisible y se lee su
  // `getComputedStyle(...).color` resultante, que el browser siempre devuelve en rgb().
  function resolveCssColor(varName: string): [number, number, number] {
    const probe = document.createElement('div');
    probe.style.color = `var(${varName})`;
    probe.style.position = 'absolute';
    probe.style.opacity = '0';
    probe.style.pointerEvents = 'none';
    document.body.appendChild(probe);
    const rgb = getComputedStyle(probe).color;
    document.body.removeChild(probe);
    const match = rgb.match(/[\d.]+/g);
    if (!match) return hexToRgb01('#080A09');
    return [Number(match[0]) / 255, Number(match[1]) / 255, Number(match[2]) / 255];
  }

  let renderer: InstanceType<typeof Renderer> | undefined;
  let program: InstanceType<typeof Program> | undefined;
  let mesh: InstanceType<typeof Mesh> | undefined;
  let rafId = 0;
  let io: IntersectionObserver | undefined;
  let inView = true;
  let container: HTMLElement | null;
  let onResize: (() => void) | undefined;

  function initShaderField() {
    const canvas = document.querySelector<HTMLCanvasElement>('[data-shader-canvas]');
    container = canvas?.closest('.shader-field') ?? null;
    if (!canvas || !container) return;

    // Regla dura §17.3 #2: sin JS para animar bajo reduced-motion -- se omite el canvas
    // por completo y queda SOLO el gradiente CSS estático (siempre presente, ver <style>
    // abajo).
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let gl: WebGLRenderingContext | WebGL2RenderingContext;
    try {
      renderer = new Renderer({ canvas, alpha: false, antialias: true, dpr: Math.min(window.devicePixelRatio || 1, 2) });
      gl = renderer.gl;
    } catch {
      // WebGL no disponible -- el gradiente CSS de abajo ya cubre este caso.
      return;
    }

    const colorBg = resolveCssColor('--bg-primary');
    const colorAccent = resolveCssColor('--accent');
    const colorAccentLight = resolveCssColor('--accent-hover');

    const geometry = new Triangle(gl);
    program = new Program(gl, {
      vertex: VERT,
      fragment: FRAG,
      uniforms: {
        uTime: { value: 0 },
        uResolution: { value: [container.clientWidth, container.clientHeight] },
        uColorBg: { value: colorBg },
        uColorAccent: { value: colorAccent },
        uColorAccentLight: { value: colorAccentLight },
      },
    });
    mesh = new Mesh(gl, { geometry, program });

    function resize() {
      if (!renderer || !container || !program) return;
      const w = container.clientWidth;
      const h = container.clientHeight;
      renderer.setSize(w, h);
      program.uniforms.uResolution.value = [w, h];
    }
    resize();
    onResize = resize;
    window.addEventListener('resize', onResize);

    io = new IntersectionObserver(([entry]) => { inView = entry.isIntersecting; }, { threshold: 0 });
    io.observe(container);

    // Nota: la pausa en background pasa por el chequeo `document.hidden` DENTRO del
    // loop de abajo, en cada frame -- no hace falta (ni conviene) un listener de
    // `visibilitychange` aparte: una versión anterior mezclaba `inView &&= !hidden`, lo
    // que podía dejar `inView` en false para siempre tras un solo backgrounding, aunque
    // el IntersectionObserver siguiera diciendo que el elemento está a la vista (bug
    // real: el shader nunca volvía a animar).

    // `t` (el timestamp de rAF, en milisegundos desde la navegación) nunca se pasa
    // crudo al shader: sin/cos en GPU pierden precisión con ángulos grandes y el
    // movimiento se vuelve tembloroso/errático cuanto más tiempo lleva la pestaña
    // abierta (bug real detectado: "se mueve extraño"). Se normaliza a segundos desde
    // el primer frame de ESTA instancia -- arranca siempre chico y predecible.
    let startTime: number | undefined;
    function update(t: number) {
      rafId = requestAnimationFrame(update);
      if (!inView || document.hidden || !renderer || !program || !mesh) return;
      if (startTime === undefined) startTime = t;
      program.uniforms.uTime.value = (t - startTime) / 1000;
      renderer.render({ scene: mesh });
    }
    rafId = requestAnimationFrame(update);
  }

  function cleanupShaderField() {
    cancelAnimationFrame(rafId);
    io?.disconnect();
    io = undefined;
    if (onResize) window.removeEventListener('resize', onResize);
    onResize = undefined;
    // Libera el contexto WebGL explícitamente -- sin esto, cada navegación (View
    // Transitions) deja un contexto GL huérfano y los navegadores limitan cuántos
    // pueden existir a la vez.
    try {
      renderer?.gl.getExtension('WEBGL_lose_context')?.loseContext();
    } catch {
      /* noop */
    }
    renderer = undefined;
    program = undefined;
    mesh = undefined;
  }

  document.addEventListener('astro:page-load', initShaderField);
  document.addEventListener('astro:before-swap', cleanupShaderField);
</script>

<style>
  .shader-field {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    /* Fallback SIEMPRE presente (§17.3 #2): gradiente estático equivalente en CSS puro,
       visible de entrada y lo único que queda sin JS, con reduced-motion, o si WebGL no
       está disponible -- nunca una pantalla vacía. */
    background:
      radial-gradient(60% 55% at 28% 68%, color-mix(in srgb, var(--accent) 55%, transparent) 0%, transparent 70%),
      radial-gradient(55% 50% at 74% 30%, color-mix(in srgb, var(--accent-hover) 30%, transparent) 0%, transparent 70%),
      var(--bg-primary);
  }

  .shader-field__canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .shader-field__canvas { display: none; }
  }
</style>
