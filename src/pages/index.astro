---
// src/pages/index.astro — Grupo Los Robles
// "ART DIRECTION RESET" (pedido explicito del Ingeniero Líder, reemplaza TODAS las
// direcciones anteriores de este archivo): la Home pasa a tener Hero, Industries,
// Contact (+ Footer como cierre, no un momento narrativo aparte). "LESS, BUT
// EXCEPTIONAL": se elimina todo lo que repetia fotografia/video/mensaje institucional
// ya dicho en otra seccion (VideoReveal, ManifestoSection, ContactReveal quedaron
// fuera -- ver git history si hace falta recuperarlos). La sección "Nuestro alcance"
// (Legacy.astro, las 4 cifras) se eliminó por pedido explícito del Ingeniero Líder
// ("se ven burdas", quería toda la sección afuera, no solo los números) -- el
// componente sigue en el repo por si hace falta recuperarlo, pero no se usa en la Home.
// Un solo verde institucional en toda la interfaz (ver theme.css).
import Layout from '../layouts/Layout.astro';
import HomeReplica from '../components/HomeReplica.astro';
import site from '../../contracts/site.json';

const _seo = {
  title: `${site.site.siteName} · ${site.site.tagline}`,
  description: site.organizationSchema.description,
  ogImage: site.site.defaultOgImage,
  // Bodoni Moda sumado al final -- SOLO lo usa HomeReplica.astro (réplica exacta del
  // prototipo _pruebas/robles-scroll/index.html, pedido explícito del Ingeniero
  // Líder). Mismo fragmento exacto de la URL que el prototipo (400;500 -- el wordmark
  // en 700 cae fuera del rango cargado a propósito, igual que en el archivo original).
  googleFontsUrl:
    'https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600&family=Inter:wght@300;400;500;600&family=Bodoni+Moda:opsz,wght@6..96,400;6..96,500&display=swap',
};

const _schema = site.organizationSchema;

// Orden actualizado (pedido explicito del Ingeniero, brief "The Grand Entrance"):
// Vestuario, Agrícola, Gastronomía, Tecnología, Inmobiliaria. Cascada automatica a
// IndustriesGallery y Contacto -- consumen este mismo array.
//
// `reelLabel`: texto de la cortina del Hero (carrete de 5 videos) -- el operador/marca
// real detrás de cada división, no el nombre de la industria (que ya se ve en
// IndustriesGallery más abajo, no hay que repetirlo). Son los mismos nombres ya reales
// en esta misma data (brands[].name de vestuario, "Valbifrut"/"Mil Sabores"/
// "Dot Solutions" en las descripciones/ctaHref, projects[0] de inmobiliaria).
const _divisions = [
  {
    id: 'vestuario',
    number: '01',
    name: 'Vestuario Retail',
    reelLabel: 'Boss · Hugo · Geox',
    description:
      'Representamos y operamos en Chile marcas globales de vestuario y accesorios, con presencia en los principales centros comerciales del país.',
    image: 'images/lujo-silencioso/division-vestuario.jpg',
    alt: 'Detalle de boutique de moda minimalista',
    featured: true,
    brands: [
      { name: 'BOSS', locations: ['Costanera Center', 'Parque Arauco', 'Plaza Antofagasta'] },
      { name: 'HUGO', locations: ['Parque Arauco', 'Costanera Center'] },
      { name: 'GEOX', locations: ['Parque Arauco'] },
    ],
    ctaLabel: 'Visitar hugoboss.cl',
    ctaHref: 'https://www.hugoboss.cl',
  },
  {
    id: 'agricola',
    number: '02',
