    // el escritorio generico de stock.
    image: 'images/dot-solutions/office-santiago.jpg',
    alt: 'Sala de reuniones de Dot Solutions con dashboard de datos en pantalla',
    ctaLabel: 'Visitar dotsolutions.io',
    ctaHref: 'https://dotsolutions.io',
  },
  {
    id: 'inmobiliaria',
    number: '05',
    name: 'Inmobiliaria',
    reelLabel: 'Los Robles Investments',
    description:
      'Gestionamos y desarrollamos proyectos comerciales y de oficinas, priorizando ubicaciones con excelente conectividad y flujo.',
    image: 'images/lujo-silencioso/division-inmobiliario.jpg',
    alt: 'Fachada arquitectónica moderna al atardecer',
    projects: [
      'Los Robles Investments',
      'Inmobiliaria Los Nogales: Av. El Bosque (Daniel Hernández) N°307',
      'Inmobiliaria la Araucaria: Centro Industrial El Belloto, Playa Madre',
      'Neocisterna / Inversiones: Donde Gastón',
    ],
  },
];

---

<Layout
  title={_seo.title}
  description={_seo.description}
  image={_seo.ogImage}
  googleFontsUrl={_seo.googleFontsUrl}
  schemaData={_schema}
  chrome={false}
>
  <HomeReplica divisions={_divisions} locale="es" />
</Layout>
