---
// src/pages/en/index.astro — Grupo Los Robles (English)
// Mirror of src/pages/index.astro — same structure/data, English copy. Keep both in sync.
// "ART DIRECTION RESET": Home has Hero, Industries, Contact (+ Footer as the close).
// The "Our Scale" section (Legacy.astro, the 4 stats) was removed entirely per explicit
// request (looked "crude"/disconnected next to the new video scenes) -- the component
// stays in the repo, just unused here.
import Layout from '../../layouts/Layout.astro';
import HomeReplica from '../../components/HomeReplica.astro';
import site from '../../../contracts/site.en.json';

const _seo = {
  title: `${site.site.siteName} · ${site.site.tagline}`,
  description: site.organizationSchema.description,
  ogImage: site.site.defaultOgImage,
  // Bodoni Moda sumado al final -- SOLO lo usa HomeReplica.astro (ver src/pages/index.astro).
  googleFontsUrl:
    'https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600&family=Inter:wght@300;400;500;600&family=Bodoni+Moda:opsz,wght@6..96,400;6..96,500&display=swap',
};

const _schema = site.organizationSchema;

// Updated order (explicit request, "The Grand Entrance" brief): Apparel, Agriculture,
// Gastronomy, Technology, Real Estate. Cascades automatically to IndustriesGallery and
// Contact -- they consume this same array.
const _divisions = [
  {
    id: 'vestuario',
    number: '01',
    name: 'Apparel Retail',
    reelLabel: 'Boss · Hugo · Geox',
    description:
      'We represent and operate global apparel and accessories brands in Chile, with a presence in the country’s leading shopping centers.',
    image: 'images/lujo-silencioso/division-vestuario.jpg',
    alt: 'Detail of a minimalist fashion boutique',
    featured: true,
    brands: [
      { name: 'BOSS', locations: ['Costanera Center', 'Parque Arauco', 'Plaza Antofagasta'] },
      { name: 'HUGO', locations: ['Parque Arauco', 'Costanera Center'] },
      { name: 'GEOX', locations: ['Parque Arauco'] },
    ],
    ctaLabel: 'Visit hugoboss.cl',
    ctaHref: 'https://www.hugoboss.cl',
  },
  {
    id: 'agricola',
    number: '02',
    name: 'Agriculture',
    reelLabel: 'Valbifrut',
    description:
      'With over 30 years of trajectory, Valbifrut is the second-largest walnut exporter in Chile. Leadership built with a long-term vision of the land.',
    image: 'images/lujo-silencioso/division-agricola.jpg',
    alt: 'Walnuts on a wooden surface, warm light',
    ctaLabel: 'Visit valbifrut.cl',
    ctaHref: 'https://valbifrut.cl',
  },
  {
    id: 'gastronomia',
