    // and systems, explicit brief request) -- replaces the generic stock desk shot.
    image: 'images/dot-solutions/office-santiago.jpg',
    alt: 'Dot Solutions meeting room with a data dashboard on screen',
    ctaLabel: 'Visit dotsolutions.io',
    ctaHref: 'https://dotsolutions.io',
  },
  {
    id: 'inmobiliaria',
    number: '05',
    name: 'Real Estate',
    reelLabel: 'Los Robles Investments',
    description:
      'We manage and develop commercial and office projects, prioritizing locations with excellent connectivity and flow.',
    image: 'images/lujo-silencioso/division-inmobiliario.jpg',
    alt: 'Modern architectural facade at dusk',
    projects: [
      'Los Robles Investments',
      'Inmobiliaria Los Nogales: Av. El Bosque (Daniel Hernández) N°307',
      'Inmobiliaria la Araucaria: Centro Industrial El Belloto, Playa Madre',
      'Neocisterna / Inversiones: Donde Gastón',
    ],
  },
];

---

<Layout
  title={_seo.title}
  description={_seo.description}
  image={_seo.ogImage}
  googleFontsUrl={_seo.googleFontsUrl}
  schemaData={_schema}
  locale="en"
  chrome={false}
>
  <HomeReplica divisions={_divisions} locale="en" />
</Layout>
